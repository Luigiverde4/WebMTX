# =============================================================================
# Configuración de WebMTX por equipo/despliegue
#
#   1. Copia este fichero:      cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#   2. Ajusta los valores para este equipo.
#   3. Aplica:                  docker compose up -d
#
# .env NO se sube a git (está en .gitignore): cada equipo tiene el suyo.
# Todas las variables tienen un valor por defecto: el .env solo hace falta para cambiarlas.
# Comprueba el resultado con: docker compose config
# =============================================================================

# --- Red ----------------------------------------------------------------------

# OPCIONAL. IPs que MediaMTX anuncia para WebRTC, separadas por comas, sin espacios.
# No hace falta para usar WebMTX: nuestras páginas (Emitir, Ver, salida de OBS)
# añaden ellas mismas la IP con la que se abrieron, en cualquier red.
# Solo para clientes WebRTC que no son nuestras páginas (la salida WHIP de OBS,
# ffmpeg, el visor de GStreamer): pon aquí la IP de este equipo en la red local.
# Ver las IPs:  Get-NetIPAddress -AddressFamily IPv4   (o ipconfig)
# WEBRTC_HOSTS=192.168.1.50

# Puertos publicados en el equipo para la web.
# Cambia PUERTO_HTTP si el 80 lo usa otro servicio (o desactiva la redirección).
PUERTO_HTTPS=443
PUERTO_HTTP=80

# Redirección http:// -> https:// en PUERTO_HTTP. false = no se escucha en él.
HTTP_REDIRECT=true

# --- Grabaciones ---------------------------------------------------------------

# Cuánto tiempo se conservan las grabaciones (= ventana máxima de repetición).
# Formato de MediaMTX: 30m, 12h, 7d... 0s = no borrar nunca (vigila el disco).
RETENCION_GRABACIONES=7d

# --- Diagnóstico -----------------------------------------------------------------

# Nivel de log de MediaMTX: error, warn, info o debug.
NIVEL_LOG_MEDIAMTX=info

# production oculta los detalles internos de los errores en las respuestas HTTP.
# development solo para depurar el servidor Node.
NODE_ENV=production
